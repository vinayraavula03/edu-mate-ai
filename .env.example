# ==============================================================================
# EduMate AI - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with secrets to version control.
# ==============================================================================

# Backend (FastAPI on Render / Local)
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini API (Free tier)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get your URL and Keys from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Pexels API (Optional - for educational illustrations)
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Frontend (Vite / Netlify)
# These are exposed to the browser bundle during build time
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_API_URL=http://localhost:8000
